# Copia a .env y cambia TODOS los valores. Nunca subas .env al repositorio.
ENV=prod
LOG_LEVEL=INFO

# --- Secretos (genera con: openssl rand -hex 48) ---
JWT_SECRET=CAMBIAME_openssl_rand_hex_48
METRICS_TOKEN=CAMBIAME_openssl_rand_hex_24

# --- Base de datos (usados por docker-compose) ---
POSTGRES_USER=familias
POSTGRES_PASSWORD=CAMBIAME
POSTGRES_DB=familias

# --- MinIO (S3) ---
MINIO_ROOT_USER=familias
MINIO_ROOT_PASSWORD=CAMBIAME_minimo_8_caracteres
S3_BUCKET=familias

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAME

# --- Google Sign-In: client IDs de Google Cloud Console (web y android), separados por coma ---
GOOGLE_CLIENT_IDS=

# --- Cloudflare Tunnel (perfil "tunnel") ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Carga inicial al arrancar el contenedor ---
SEED_ON_START=true
SEED_DEMO=            # pon "1" para crear cuentas de demostración
ADMIN_EMAIL=admin@familiasquesuman.com
ADMIN_PASSWORD=       # vacío = se genera y se imprime en los logs del contenedor la primera vez

# --- Opcional ---
CORS_ORIGINS=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EXEMPT_IPS=  
WORKERS=1   
