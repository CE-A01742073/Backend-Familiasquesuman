{
  "uid": "familias-seguridad",
  "title": "Familias que Suman — API y seguridad",
  "tags": ["familias", "seguridad"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Peticiones / s",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } }
    },
    {
      "id": 2, "type": "stat", "title": "Logins fallidos (5 min)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(familias_logins_fallidos_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 25 } ] } } }
    },
    {
      "id": 3, "type": "stat", "title": "401 / 403 (5 min)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(http_requests_total{status=~\"401|403\"}[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 } ] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Latencia p95",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Logins: exitosos vs fallidos (por minuto)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(familias_logins_total[1m])) * 60", "legendFormat": "exitosos", "refId": "A" },
        { "expr": "sum(rate(familias_logins_fallidos_total[1m])) * 60 ", "legendFormat": "fallidos", "refId": "B" },
        { "expr": "sum(rate(familias_logins_fallidos_total{motivo=\"bloqueado\"}[1m])) * 60", "legendFormat": "cuenta bloqueada", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Respuestas por código HTTP",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (status) * 60", "legendFormat": "{{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Inscripciones (ok vs sin cupo)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(increase(familias_inscripciones_total[5m])) by (resultado)", "legendFormat": "{{resultado}}", "refId": "A" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Rate limit (429) y uploads rechazados",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=\"429\"}[1m])) * 60", "legendFormat": "429 / min", "refId": "A" },
        { "expr": "sum(rate(familias_uploads_rechazados_total[1m])) * 60", "legendFormat": "uploads rechazados / min", "refId": "B" }
      ]
    },
    {
      "id": 9, "type": "table", "title": "Rutas más lentas (p95)",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(8, histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler)))", "format": "table", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } }
    }
  ]
}
